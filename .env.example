# Copy to .env.local for local development. Never commit real values.
# Production values live only in Vercel environment variables.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Entra (Aleida's tenant)
MS_TENANT_ID=
# "Quail Hollow Client Portal" app (Sites.Selected, application permission)
MS_PORTAL_CLIENT_ID=
MS_PORTAL_CLIENT_SECRET=
# "Quail Hollow Portal Admin Sign-in" app (delegated openid profile email User.Read)
MS_ADMIN_CLIENT_ID=
MS_ADMIN_CLIENT_SECRET=
# Optional: authority for admin sign-in. Defaults to MS_TENANT_ID. See docs/entra-setup.md.
MS_ADMIN_AUTHORITY_TENANT=
# Optional: extra tenant IDs admins may sign in from (comma separated).
MS_ADMIN_ALLOWED_TENANTS=

# SharePoint target (see docs/entra-setup.md step 4)
SP_SITE_ID=
SP_DRIVE_ID=
SP_CLIENT_ROOT_FOLDER_ID=
# Optional: SharePoint host, e.g. contoso.sharepoint.com. Tightens the CSP connect-src.
SP_HOSTNAME=

# Admin access
ADMIN_ALLOWLIST=aleida@quailhollowaccounting.com,todd@dublowdigital.com
# Backup admin sign-in with an emailed code, for when Microsoft sign-in is down.
# Single-factor: leave unset (off) in production once Microsoft sign-in works.
ADMIN_EMAIL_LOGIN=
# Optional: who receives "new upload" emails. Defaults to the first ADMIN_ALLOWLIST entry.
ADMIN_NOTIFY_EMAILS=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# App
APP_BASE_URL=
# At least 32 random characters, e.g. `openssl rand -base64 48`
AUTH_SECRET=
